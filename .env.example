# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Banco de dados (PostgreSQL via Docker Compose)
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Chave de assinatura das sessões: mínimo 32 caracteres aleatórios.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origens permitidas no CORS (vazio = apenas mesma origem, via proxy do nginx)
CORS_ORIGINS=

# --- Execução local sem Docker (backend/) ---
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./sigcem_dev.db
